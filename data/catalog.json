      ],
      "pipelines": [
        "reset_generation",
        "teacher_training",
        "teacher_evaluation",
        "rgb_collection",
        "mimicgen_collection",
        "native_passthrough"
      ],
      "nativeInputs": [
        "task and embodiment contract",
        "reset pools stored with Git LFS",
        "state-policy checkpoint stored with Git LFS",
        "optional system-identification bundle"
      ],
      "nativeOutputs": [
        "reset pools (.pt)",
        "successful rollout trajectories",
        "LeRobot Dataset v3 with H.264 RGB",
        "evaluation and release evidence"
      ],
      "limitations": [
        "Other RL tasks require their own reviewed action profile and golden parity evidence."
      ],
      "goldenRequirements": [
        "one canonical sim task bundle",
        "released checkpoint and reset-pool access",
        "expected fixed-seed rollout metrics"
      ],
      "integrityGates": [
        "verify every Git LFS object and SHA256SUMS entry before execution",
        "verify task, robot asset, reset pool, action scale, observation shape, controller and checkpoint",
        "preserve native action values and require an exact reviewed action profile before canonical export",
        "preserve the two-pass state/RGB equivalence gate for MimicGen p=1",
        "report per-reset and per-stage success, fixed seeds and sample counts",
        "never promote on aggregate success rate alone"
      ],
      "upstream": {
        "url": "https://github.com/KIM-JAKE/Data-Engine.git",
        "commit": "394b6c7f6e3e",
        "tree": "66349efaaf6d",
        "path": "vendor/rl_teacher"
      },
      "code": {
        "component": "components/rl_teacher/component.yaml",
        "module": "modules/rl_teacher/module.yaml",
        "vendor": "vendor/rl_teacher"
      }
    },
    {
      "id": "robot_3dpc",
      "name": "Robot 3DPC / demogen-rgbd",
      "role": "real_pixel_spatial_augmentation",
      "summary": "Reconstruct layered RGB-D demonstrations, apply spatial augmentations, and validate exported robot trajectories.",
      "integrationStatus": "smoke_validated_waiting_full_golden",
      "adapterStatus": "implemented",
      "adapterScope": "franka_teleop_multiview_v1",
      "domains": [
        "real",
        "hybrid"
      ],
      "capabilities": [
        "rgb",
        "robot_state"
      ],
      "pipelines": [
        "all",
        "augment",
        "validate",
        "build_canonical_calibration",
        "canonicalize",
        "native_passthrough"
      ],
      "nativeInputs": [
        "steps.jsonl with end-effector pose, gripper state and timestamps",
        "per-camera JPEG frames",
        "task grasp/release intervals and segmentation prompts"
      ],
      "nativeOutputs": [
        "trajectory.npz, actions.csv and metadata.yaml",
        "depth, intrinsics, masks and calibration artifacts",
        "point clouds and layer transforms",
        "augmented RGB MP4",
        "benchmark and validation reports"
      ],
      "limitations": [
        "Native actions remain previous-state differences; canonical actions are independently recomputed from the timestamp-resampled pose track.",
        "Full-rate native RGB-D outputs are required for 10 Hz export; stride-30 smoke videos cannot be promoted.",
        "The selected full-frame 4:3 to 16:9 resize preserves task content but introduces anisotropic pixel scaling recorded in the calibration bundle."
      ],
      "goldenRequirements": [
        "one complete multi-view real episode with steps.jsonl and frames",
        "task contact intervals and object prompts",
        "expected identity reconstruction and calibration metrics"
      ],
      "integrityGates": [
        "verify state/action convention, frame counts, timestamps and video rate",
        "invalidate and rebuild the background plate whenever masks change",
        "report calibration residuals and observability; never hide regularized wrist translation",
        "preserve identity reconstruction PSNR, SSIM, seam and temporal metrics",
        "record whether any background pixels were generated rather than copied"
      ],
      "upstream": {
        "url": "https://github.com/KIM-JAKE/Data-Engine.git",
        "commit": "48a42882a9e6",
        "tree": "200218a3c11b",
        "path": "vendor/robot_3dpc"
      },
      "code": {
        "component": "components/robot_3dpc/component.yaml",
        "module": "modules/robot_3dpc/module.yaml",
        "vendor": "vendor/robot_3dpc"
      }
    },
