{
  "product": {
    "name": "Physical Data Engine",
    "workflow": "seed-demo-to-training-v1",
    "apiVersion": "physical-data-engine/workflow@v1",
    "failClosed": true
  },
  "contract": {
    "schema": "pde/training-dataset@v1",
    "timebase": {
      "rate_hz": 10,
      "timestamp_unit": "s",
      "alignment": "timestamp",
      "max_skew_s": 0.05,
      "terminal_policy": "keep_with_validity_mask"
    },
    "action": {
      "schema": "pde/eef-delta@v1",
      "feature_name": "action.eef_delta_metric",
      "validity_feature_name": "action.eef_delta_metric_valid",
      "validity_layout": "per_dimension",
      "rate_hz": 10,
      "frame": "robot_base",
      "representation": "delta_cartesian",
      "translation": {
        "units": "m"
      },
      "rotation": {
        "representation": "axis_angle",
        "units": "rad",
        "composition": "left_multiply_in_base_frame"
      },
      "gripper": {
        "representation": "binary_closed",
        "open": 0,
        "closed": 1
      },
      "temporal_semantics": "command_at_t",
      "preserve_native_action": true,
      "missing_dimension_policy": "reject"
    },
    "images": {
      "rate_hz": 10,
      "dtype": "uint8",
      "layout": "HWC",
      "color_space": "srgb",
      "size": {
        "width": 320,
        "height": 180
      },
      "views": {
        "required": [
          "third_person_0",
          "third_person_1",
          "wrist"
        ],
        "optional": []
      },
      "missing_view_policy": "reject",
      "resize": {
        "policy": "stretch",
        "interpolation": "area"
      },
      "calibration": {
        "intrinsics": "required",
        "extrinsics": "required",
        "distortion": "preserve",
        "frame_graph": "required"
      }
    },
    "storage": {
      "primary": {
        "format": "lerobot_v3",
        "tabular": {
          "format": "parquet",
          "compression": "zstd"
        },
        "video": {
          "allowed_codecs": [
            "h264",
            "av1"
          ],
          "pixel_format": "yuv420p",
          "fps": 10
        }
      },
      "native_artifacts": {
        "preserve": true,
        "include": [
          "hdf5",
          "mcap",
          "parquet",
          "mp4",
          "npz",
          "pt"
        ]
      },
      "overwrite": false
    },
    "lineage": {
      "record_resampling": true,
      "record_resize": true,
      "record_view_mapping": true,
      "record_action_profile": true,
      "record_checksums": true
    },
    "source": "blueprints/v1.yaml"
  },
  "stages": [
    {
      "id": "ingest",
      "uses": "builtin.ingest",
      "enabled": true,
      "config": {
        "verify_checksums": true,
        "preserve_native_artifacts": true
      }
    },
    {
      "id": "contract_validate",
      "uses": "builtin.contract_validate",
      "enabled": true,
      "needs": [
        "ingest"
      ]
    },
    {
      "id": "rl_teacher",
      "uses": "rl_teacher",
      "enabled": false,
      "needs": [
        "contract_validate"
      ],
      "config": {
        "canonical_adapter_scope": "reviewed_cube_collector_slice"
      }
    },
    {
      "id": "sim_retargeting",
      "uses": "sim_retargeting",
      "enabled": false,
      "needs": [
        "contract_validate"
      ],
      "config": {
        "canonical_adapter_scope": "reviewed_cube_conversion_export_slice"
      }
    },
    {
      "id": "neural_trajectory",
      "uses": "neural_trajectory",
      "enabled": false,
      "needs": [
        "contract_validate"
      ]
    },
    {
      "id": "robot_3dpc",
      "uses": "robot_3dpc",
      "enabled": false,
      "needs": [
        "contract_validate"
      ],
      "config": {
        "canonical_adapter_scope": "franka_teleop_multiview_v1"
      }
    },
    {
      "id": "splataug_3dgs",
      "uses": "splataug_3dgs",
      "enabled": false,
      "needs": [
        "contract_validate"
      ]
    },
    {
      "id": "merge",
      "uses": "builtin.lineage_merge",
      "enabled": true,
      "needs": [
        "contract_validate",
        "rl_teacher",
        "sim_retargeting",
        "neural_trajectory",
        "robot_3dpc",
        "splataug_3dgs"
      ],
      "config": {
        "deduplicate_by": [
          "content_sha256",
          "parent_episode_id",
          "transform_digest"
        ],
        "allow_native_passthrough": true
      }
    },
    {
      "id": "canonicalize",
      "uses": "builtin.canonicalize_outputs",
      "enabled": true,
      "needs": [
        "merge"
      ]
    },
    {
      "id": "filter_contract",
      "uses": "builtin.filter_contract",
      "enabled": false,
      "needs": [
        "canonicalize"
      ]
    },
    {
      "id": "filter_kinematic",
      "uses": "builtin.filter_kinematic",
      "enabled": false,
      "needs": [
        "filter_contract"
      ]
    },
    {
      "id": "filter_physics_replay",
      "uses": "builtin.filter_physics_replay",
      "enabled": false,
      "needs": [
        "filter_kinematic"
      ]
    },
    {
      "id": "filter_task_success",
      "uses": "builtin.filter_task_success",
      "enabled": false,
      "needs": [
        "filter_kinematic",
        "filter_physics_replay"
      ]
    },
    {
      "id": "filter_visual_quality",
      "uses": "builtin.filter_visual_quality",
      "enabled": false,
      "needs": [
        "filter_kinematic"
      ]
    },
    {
      "id": "curate_diversity",
      "uses": "builtin.curate_diversity",
      "enabled": false,
      "needs": [
        "filter_kinematic",
        "filter_task_success",
        "filter_visual_quality"
      ]
    },
    {
      "id": "split",
      "uses": "builtin.leakage_safe_split",
      "enabled": false,
      "needs": [
        "curate_diversity"
      ],
      "config": {
        "group_by": "root_seed_episode_id",
        "ratios": {
          "train": 0.8,
          "validation": 0.1,
          "test": 0.1
        }
      }
    },
    {
      "id": "train",
      "uses": "builtin.train",
      "enabled": false,
      "needs": [
        "split"
      ]
    }
  ],
  "modules": [
    {
      "id": "neural_trajectory",
      "name": "Neural Trajectory Pipeline",
      "role": "video_trajectory_generation",
      "summary": "Generate branched video trajectories, infer pseudo-actions with the matching IDM, and filter action coherence.",
      "integrationStatus": "checkpoints_verified_native_runtime_in_progress",
      "adapterStatus": "planned",
      "adapterScope": null,
      "domains": [
        "real",
        "synthetic",
        "hybrid"
      ],
      "capabilities": [
        "rgb"
      ],
      "pipelines": [
        "verify_assets",
        "merge_world_model",
        "prepare_prompt_embeddings",
        "prepare_world_input",
        "assemble_inputs",
        "generate_tree",
        "generate_smoke_clip",
        "prepare_idm",
        "infer_actions",
        "filter",
        "review",
        "native_passthrough"
      ],
      "nativeInputs": [
        "768x432 four-tile conditioning image",
        "task-specific Cosmos Predict2 LoRA, its separately gated base/tokenizer, and the verified reconstructed native checkpoint",
        "fine-tuned GR00T-Dreams IDM checkpoint plus the packaged training statistics"
      ],
      "nativeOutputs": [
        "93-frame generated clips and 369-frame stitched trajectories",
        "LeRobot-layout three-camera video dataset",
        "28-D pseudo-actions at 15 Hz",
        "filter_results.json and self-contained review HTML/data"
      ],
      "limitations": [
        "The native IDM rotation slice is invalid and cannot satisfy reject-on-missing dimensions.",
        "The 15 Hz pose-track resampler and camera calibration passthrough are not implemented."
      ],
      "goldenRequirements": [
        "conditioning frame and source camera layout",
        "locked IDM checkpoint plus materialized exact training stats",
        "held-out real demonstrations and expected filter results"
      ],
      "integrityGates": [
        "require the IDM dumper patch and record its applied commit/digest",
        "verify every checkpoint file against components/neural_trajectory/asset-lock.json",
        "materialize stats.json only from the locked IDM experiment metadata and verify its semantic digest",
        "assert stitched frame count and explicit 16 fps encoding",
        "preserve raw gripper vote alongside postprocessed state",
        "treat C1-C3 as action-coherence only, never task-success evidence",
        "block physics promotion until dataset-to-simulator frame alignment is supplied and replay succeeds"
      ],
      "upstream": {
        "url": "https://github.com/finde30526/neural-trajectory-pipeline.git",
        "commit": "981610c3e079",
        "tree": "4b0fb7e52961",
        "path": "vendor/neural_trajectory"
      },
      "code": {
        "component": "components/neural_trajectory/component.yaml",
        "module": "modules/neural_trajectory/module.yaml",
        "vendor": "vendor/neural_trajectory"
      }
    },
    {
      "id": "rl_teacher",
      "name": "RL-Teacher / OmniReset FR3",
      "role": "sim_teacher_rollout",
      "summary": "Generate reset pools, train or evaluate state teachers, and collect successful RGB rollouts in Isaac Sim.",
      "integrationStatus": "validated_collector_slice",
      "adapterStatus": "implemented",
      "adapterScope": "reviewed_cube_collector_slice",
      "domains": [
        "sim",
        "real",
        "hybrid"
      ],
