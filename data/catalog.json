{
  "product": {
    "name": "Physical Data Engine",
    "workflow": "seed-demo-to-training-v1",
    "apiVersion": "physical-data-engine/workflow@v1",
    "failClosed": true
  },
  "contract": {
    "schema": "pde/training-dataset@v1",
    "timebase": {
      "rate_hz": 10,
      "timestamp_unit": "s",
      "alignment": "timestamp",
      "max_skew_s": 0.05,
      "terminal_policy": "keep_with_validity_mask_if_missing"
    },
    "action": {
      "schema": "pde/eef-delta@v1",
      "feature_name": "action.eef_delta_metric",
      "validity_feature_name": "action.eef_delta_metric_valid",
      "validity_layout": "per_dimension",
      "rate_hz": 10,
      "frame": "robot_base",
      "body": "fr3_hand",
      "meaning": "desired_relative_target",
      "representation": "delta_cartesian",
      "translation": {
        "units": "m"
      },
      "rotation": {
        "representation": "axis_angle",
        "units": "rad",
        "composition": "left_multiply_in_base_frame"
      },
      "gripper": {
        "representation": "binary_closed",
        "open": 0,
        "closed": 1
      },
      "temporal_semantics": "command_at_t",
      "preserve_native_action": true,
      "missing_dimension_policy": "reject"
    },
    "images": {
      "rate_hz": 10,
      "dtype": "uint8",
      "layout": "HWC",
      "color_space": "srgb",
      "size": {
        "width": 320,
        "height": 180
      },
      "views": {
        "required": [
          "third_person_0",
          "third_person_1",
          "wrist"
        ],
        "optional": []
      },
      "missing_view_policy": "reject",
      "resize": {
        "policy": "stretch",
        "interpolation": "area"
      },
      "calibration": {
        "intrinsics": "required",
        "extrinsics": "required",
        "distortion": "preserve",
        "frame_graph": "required"
      }
    },
    "storage": {
      "primary": {
        "format": "lerobot_v3",
        "tabular": {
          "format": "parquet",
          "compression": "zstd"
        },
        "video": {
          "allowed_codecs": [
            "h264",
            "av1"
          ],
          "pixel_format": "yuv420p",
          "fps": 10
        }
      },
      "native_artifacts": {
        "preserve": true,
        "include": [
          "hdf5",
          "mcap",
          "parquet",
          "mp4",
          "npz",
          "pt"
        ]
      },
      "overwrite": false
    },
    "lineage": {
      "record_resampling": true,
      "record_resize": true,
      "record_view_mapping": true,
      "record_action_profile": true,
      "record_execution_profile": true,
      "record_canonical_body_transform": true,
      "record_checksums": true
    },
    "source": "blueprints/v1.yaml"
  },
  "inputs": {
    "userSupplied": [
      {
        "id": "seed_dataset_manifest",
        "kind": "dataset reference",
        "role": "Sim or real seed demonstrations with immutable native artifacts.",
        "status": "selected by operator"
      },
      {
        "id": "task_asset_bundle",
        "kind": "checksummed asset bundle",
        "role": "Robot geometry, cube/table assets, calibration bindings, and task identity.",
        "status": "contract_extension_pass_exact_payload_identity",
        "evidence": "evaluations/task_assets/fr3_cube_stack_bundle_v2_20260825.json",
        "artifact": "assets/task_bundles/fr3_cube_stack_omnireset_v2.json"
      },
      {
        "id": "splataug_raw_capture",
        "kind": "immutable capture boundary",
        "role": "Raw multiview capture, camera/ChArUco observations, pinned trainer checkout and vocabulary, robot geometry, qpos, object/task definitions.",
        "status": "required for full 3DGS run",
        "owner": "operator / external source"
      }
    ],
    "repairOnly": [
      {
        "id": "initial_scene_registration",
        "kind": "checkpoint",
        "role": "Accepted only by the isolated 3DGS artifact-repair workflow; never a normal full-run input.",
        "status": "optional repair boundary"
      }
    ],
    "derived": [
      {
        "id": "resolved_robot_urdf",
        "path": "geometry/fr3.resolved.urdf",
        "role": "Execution-only URDF with every original mesh URI resolved to a checksummed file.",
        "owner": "splataug_3dgs",
        "status": "derived by module"
      },
      {
        "id": "resolved_robot_report",
        "path": "geometry/fr3.resolved.report.json",
        "role": "Source URDF and per-mesh identity provenance.",
        "owner": "splataug_3dgs",
        "status": "derived by module"
      },
      {
        "id": "fr3_surface_qpos",
        "path": "geometry/fr3_surface_qpos.npz",
        "role": "Deterministic posed FR3 visual surface with xyz, link, and qpos arrays.",
        "owner": "splataug_3dgs",
        "status": "derived by module"
      },
      {
        "id": "fr3_surface_report",
        "path": "geometry/fr3_surface_qpos.report.json",
        "role": "URDF, mesh, qpos, sampling, and checksum provenance.",
        "owner": "splataug_3dgs",
        "status": "derived by module"
      },
      {
        "id": "scene_registration",
        "path": "registration/scene_registration_fr3_refined.json",
        "role": "Metric registration refined against the capture-pose FR3 surface under the native gate.",
        "owner": "splataug_3dgs",
        "status": "derived; rejected by native gate"
      },
      {
        "id": "preliminary_labels",
        "path": "articulation/fr3_labels.preliminary.npy",
        "role": "Preliminary native nearest-CAD ownership used only to estimate the joint-1 axis.",
        "owner": "splataug_3dgs",
        "status": "not produced (upstream gate blocked)"
      },
      {
        "id": "preliminary_robot_ply",
        "path": "articulation/fr3_robot.preliminary.ply",
        "role": "Preliminary labelled robot Gaussian subset.",
        "owner": "splataug_3dgs",
        "status": "not produced (upstream gate blocked)"
      },
      {
        "id": "preliminary_label_report",
        "path": "articulation/fr3_labels.preliminary.report.json",
        "role": "Original nearest-CAD label audit.",
        "owner": "splataug_3dgs",
        "status": "not produced (upstream gate blocked)"
      },
      {
        "id": "axis_correction",
        "path": "registration/scene_registration_axis_corrected.json",
        "role": "Original joint-1 axis-corrected reconstruction-to-base transform.",
        "owner": "splataug_3dgs",
        "status": "not produced (upstream gate blocked)"
      },
      {
        "id": "fr3_labels",
        "path": "articulation/fr3_labels.npy",
        "role": "Final native link-ownership vector generated with the corrected registration.",
        "owner": "splataug_3dgs",
        "status": "not produced (upstream gate blocked)"
      },
      {
        "id": "fr3_robot_ply",
        "path": "articulation/fr3_robot.ply",
        "role": "Final labelled robot Gaussian subset.",
        "owner": "splataug_3dgs",
        "status": "not produced (upstream gate blocked)"
      },
      {
        "id": "fr3_label_report",
        "path": "articulation/fr3_labels.report.json",
        "role": "Final original nearest-CAD label audit.",
        "owner": "splataug_3dgs",
        "status": "not produced (upstream gate blocked)"
      }
    ],
    "evidence": "modules/splataug_3dgs/workflows/fr3_articulation_assets.v1.yaml",
    "splataugStatus": "blocked_by_native_visual_gates"
  },
  "stages": [
    {
      "id": "ingest",
      "uses": "builtin.ingest",
      "enabled": true,
      "config": {
        "verify_checksums": true,
        "preserve_native_artifacts": true
      }
    },
    {
      "id": "contract_validate",
      "uses": "builtin.contract_validate",
      "enabled": true,
      "needs": [
        "ingest"
      ]
    },
    {
      "id": "rl_teacher",
      "uses": "rl_teacher",
      "enabled": false,
      "needs": [
        "contract_validate"
      ],
      "config": {
        "canonical_adapter_scope": "reviewed_cube_collector_slice"
      }
    },
    {
      "id": "sim_retargeting",
      "uses": "sim_retargeting",
      "enabled": false,
      "needs": [
        "contract_validate"
      ],
      "config": {
        "canonical_adapter_scope": "reviewed_cube_conversion_export_slice"
      }
    },
    {
      "id": "neural_trajectory",
      "uses": "neural_trajectory",
      "enabled": false,
      "needs": [
        "contract_validate"
      ],
      "config": {
        "canonical_adapter_scope": "fixed_orientation_idm_v1"
      }
    },
    {
      "id": "robot_3dpc",
      "uses": "robot_3dpc",
      "enabled": false,
      "needs": [
        "contract_validate"
      ],
      "config": {
        "canonical_adapter_scope": "franka_teleop_fixed_three_view_v1"
      }
    },
    {
      "id": "splataug_3dgs",
      "uses": "splataug_3dgs",
      "enabled": false,
      "needs": [
        "contract_validate"
      ]
    },
    {
      "id": "merge",
      "uses": "builtin.lineage_merge",
      "enabled": true,
      "needs": [
        "contract_validate",
        "rl_teacher",
        "sim_retargeting",
        "neural_trajectory",
        "robot_3dpc",
        "splataug_3dgs"
      ],
      "config": {
        "deduplicate_by": [
          "content_sha256",
          "parent_episode_id",
          "transform_digest"
        ],
        "allow_native_passthrough": true
      }
    },
    {
      "id": "canonicalize",
      "uses": "builtin.canonicalize_outputs",
      "enabled": true,
      "needs": [
        "merge"
      ]
    },
    {
      "id": "filter_contract",
      "uses": "builtin.filter_contract",
      "enabled": false,
      "needs": [
        "canonicalize"
      ]
    },
    {
      "id": "filter_kinematic",
      "uses": "builtin.filter_kinematic",
      "enabled": false,
      "needs": [
        "filter_contract"
      ]
    },
    {
      "id": "filter_physics_replay",
      "uses": "builtin.filter_physics_replay",
      "enabled": false,
      "needs": [
        "filter_kinematic"
      ]
    },
    {
      "id": "filter_task_success",
      "uses": "builtin.filter_task_success",
      "enabled": false,
      "needs": [
        "filter_kinematic",
        "filter_physics_replay"
      ]
    },
    {
      "id": "filter_visual_quality",
      "uses": "builtin.filter_visual_quality",
      "enabled": false,
      "needs": [
        "filter_kinematic"
      ]
    },
    {
      "id": "curate_diversity",
      "uses": "builtin.curate_diversity",
      "enabled": false,
      "needs": [
        "filter_kinematic",
        "filter_task_success",
        "filter_visual_quality"
      ]
    },
    {
      "id": "split",
      "uses": "builtin.leakage_safe_split",
      "enabled": false,
      "needs": [
        "curate_diversity"
      ],
      "config": {
        "group_by": "root_seed_episode_id",
        "ratios": {
          "train": 0.8,
          "validation": 0.1,
          "test": 0.1
        }
      }
    },
    {
      "id": "train",
      "uses": "builtin.train",
      "enabled": false,
      "needs": [
        "split"
      ]
    }
  ],
