      "id": "sim_retargeting",
      "name": "Sim Retargeting / MimicGen + SART",
      "role": "sim_retargeting",
      "summary": "Retarget annotated seed demonstrations through physics-aware MimicGen, optional SART, rendering, and LeRobot export.",
      "integrationStatus": "validated_conversion_export_slice",
      "adapterStatus": "implemented",
      "adapterScope": "reviewed_cube_conversion_export_slice",
      "domains": [
        "real",
        "sim",
        "hybrid"
      ],
      "capabilities": [
        "object_centric_annotations"
      ],
      "pipelines": [
        "hf80k",
        "hf80k_preflight",
        "native_passthrough"
      ],
      "nativeInputs": [
        "annotated seed demonstrations (HDF5)",
        "measured physics posterior bundle",
        "visual randomization assets and camera contract",
        "task profile"
      ],
      "nativeOutputs": [
        "gen.hdf5 and gen.provenance.json",
        "optional SART shards, gen_sart.hdf5 and sart_report.json",
        "contract.hdf5",
        "rgb.hdf5 and vrand_log.json",
        "LeRobot Dataset v3 and chunk MANIFEST.json"
      ],
      "limitations": [
        "Profile selection must follow the controller that encoded the source artifact."
      ],
      "goldenRequirements": [
        "annotated seed HDF5 with subtask boundaries",
        "calibration and visual assets",
        "expected source-yield and output-yield measurements"
      ],
      "integrityGates": [
        "require a unique SHARD_ID and SEED_BASE per worker to prevent silent overwrite",
        "validate per-chunk manifest, episode/frame counts and uploaded artifacts",
        "preserve raw MimicGen HDF5 because rendering requires its joint state",
        "mark SART failure as degraded; Data Engine must not silently promote fallback gen.hdf5",
        "retain visual-randomization and physics sample logs per episode",
        "preserve source action gripper commands; infer from finger positions only when source actions are absent",
        "select action profiles by the controller that encoded each artifact, never by the MimicGen producer label",
        "preserve native action values and reject source-manifest/profile scale conflicts",
        "reject converted cube demonstrations unless both open and close supervision remain after resampling"
      ],
      "upstream": {
        "url": "https://github.com/KIM-JAKE/Data-Engine.git",
        "commit": "394b6c7f6e3e",
        "tree": "9f6c634c5b0c",
        "path": "vendor/sim_retargeting"
      },
